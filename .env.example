# Copie para .env e ajuste. O .env NÃO vai para o git.

# Chave de acesso à API. Sem ela, os endpoints de consulta recusam tudo (503).
# Gere uma nova com: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
PANDAPE_API_KEY=troque-esta-chave

# Porta local da API
PORT=8090

# Navegador: por padrão sobe um Chrome escondido usando a sessão salva.
# Se a sessão salva não funcionar headless, aponte para o seu Chromium aberto
# na porta de depuração (chromium --remote-debugging-port=9222):
# PANDAPE_CDP=http://localhost:9222

# Mostrar o navegador durante a coleta (0 = mostrar, 1 = escondido)
PANDAPE_HEADLESS=1

# Postgres pra persistir candidatos coletados e não repetir quem já foi usado.
# Sem isso, a API funciona normal mas sem dedup (sempre pode repetir candidato).
DATABASE_URL=postgresql://usuario:senha@host:porta/pandape_candidatos

# Webhook (ex: n8n) que recebe os candidatos de cada coleta concluída via
# POST /coletar. Sem isso, a API funciona normal, só não envia pra lugar nenhum.
WEBHOOK_URL=https://seu-n8n.com/webhook/algum-id

# Quantos candidatos por chamada de webhook (padrão; dá pra sobrescrever por
# pedido em /coletar, campo webhook_lote). Evita mandar um JSON gigante numa
# coleta grande de uma vez só.
WEBHOOK_BATCH_SIZE=20
